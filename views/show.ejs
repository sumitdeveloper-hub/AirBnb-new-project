<% layout("/layouts/boilerplate") %>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h3><%= datas.title %></h3>
            <div class="card show-card" style="width: 100%;">
  <img src="<%= datas.image.url %>" class="card-img-top show-img" alt="show-image">
  <div class="card-body">
    <p class="card-text">
       <b><%= datas.price %>/per night</b> 
        <br/>
        <%= datas.description %>
        <br/>
        <%= datas.location%>
        <br/>
        <%= datas.country%>
    </p>
   </div>
  </div>
 </div>
</div>
<div class="btns">
    <a href="/listings/<%= datas.id %>/edit" class="btn btn-danger col-1 offset-2">edit</a>
    <form method="POST" action="/listings/<%= datas.id %>?_method=DELETE">
        <button class="btn btn-dark offset-4">delete</button>
    </form>
</div>
<br/>
<br/>
<div class="col-8 offset-2">
    <h4>Leave a review</h4>
    <form action="/listing/<%= datas.id %>/review" method="POST" novalidate class="needs-validation">
    <div class="mb-3 mt-3"></div>
    <fieldset class="starability-slot">
        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
        <label for="first-rate1" title="Terrible">1 star</label>
        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
        <label for="first-rate2" title="Not good">2 stars</label>
        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
        <label for="first-rate3" title="Average">3 stars</label>
        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
        <label for="first-rate4" title="Very good">4 stars</label>
        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
        <label for="first-rate5" title="Amazing">5 stars</label>
    </fieldset>
    
        <div class="mb-3 mt-3">
            <label for="comment" class="form-label">comment</label>
            <textarea name="review[comment]" id="comment" cols="50" rows="5" class="form-control"
            required></textarea>
            <div class="invalid-feedback">please enter a valid feedback!!</div>
        </div>
        <button class="btn btn-outline-dark">Submit</button>
    </form>

    <hr>
    <% if(datas.review.length>0){ %>
    <h4>All reviews</h4>
        <div class="row ">
             <% for(review of datas.review){ %>
        <div class="card mb-3 col-5 ms-3">
            <div class="card-body">
                <h5 class="card-title">jane Doe</h5>
                <p class="starability-result card-text" data-rating=<%= review.rating %>></p>
                <p class="card-text"><%= review.comment %></p>
                
                <form class="mb-3" method="POST" action="/listing/<%= datas.id %>/review/<%=review._id %>?_method=DELETE">
                    <button class="btn btn-sm btn-dark">delete</button>
                </form>
            </div>
        </div>
        <% } %>
        </div>
<% } %>
         <div class="col-8 ">
            <h3>where you'll be</h3>
            <div id="map"></div>
        </div>
        <script>
            let mapToken="<%= process.env.MAP_TOKEN%>"
            console.log(mapToken);
            const map = new mapboxgl.Map({
            accessToken: "<%= process.env.MAP_TOKEN%>",
            container: 'map',
            style: 'mapbox://styles/mapbox/standard', 
            projection: 'globe', 
            zoom: 9, 
            center: [77.2089, 28.6139]
    });

    map.addControl(new mapboxgl.NavigationControl());
    map.scrollZoom.disable();

    map.on('style.load', () => {
        map.setFog({}); // Set the default atmosphere style
    });
</script>
</div>

       
</body>
